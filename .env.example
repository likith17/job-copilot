# Copy this file to .env and fill in only the keys you use.
# .env is git-ignored: your keys never leave your machine.

# The default setup needs no keys: open models run through Ollama.
# Optional: Claude, if you point a task at it in config.yaml
# ANTHROPIC_API_KEY=

# Optional: free/cheap OpenAI-compatible providers, if you point a task at them in config.yaml
# GROQ_API_KEY=
# GEMINI_API_KEY=
