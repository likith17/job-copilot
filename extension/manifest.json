{
  "manifest_version": 3,
  "name": "Job Copilot Autofill",
  "version": "0.1.0",
  "description": "Fills Greenhouse, Lever and Ashby applications from your Job Copilot profile and tailored documents. You click Submit.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": { "default_title": "Job Copilot: settings", "default_popup": "options.html" },
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
