{
  "manifest_version": 3,
  "name": "Job Copilot Autofill",
  "version": "0.2.0",
  "description": "Fills forms on any site from your Job Copilot profile, saved answers and resumes, even with the app closed. You click Submit.",
  "permissions": ["storage", "unlimitedStorage", "scripting", "activeTab", "contextMenus", "alarms"],
  "host_permissions": ["http://127.0.0.1:8765/*", "<all_urls>"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": { "default_title": "Job Copilot: fill this page", "default_popup": "popup.html" },
  "commands": {
    "fill-page": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Fill this page"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
